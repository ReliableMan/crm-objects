# Фронтенд (публичные значения, попадают в сборку)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon или publishable key>

# Только для локальных scripts/seed.ts и seed:reset. НИКОГДА не коммитить и не добавлять в Vercel
SUPABASE_SERVICE_ROLE_KEY=<service_role или secret key>

# Пароль демо-пользователей (для seed и security-test)
DEMO_PASSWORD=<придумайте пароль>
